[Unit]
Description=Fish Qwen Refine Worker
Requires=fish-qwen-comfyui.service
After=network-online.target fish-qwen-comfyui.service
Wants=network-online.target

[Service]
Type=simple
User=pan277942135
WorkingDirectory=/opt/fish-qwen-refine-worker
EnvironmentFile=-/etc/yujian/fish-qwen-refine-worker.env
Environment=PYTHONUNBUFFERED=1
Environment=COMFYUI_READY_TIMEOUT_SECONDS=120
Environment=COMFYUI_READY_POLL_SECONDS=2
ExecStartPre=/opt/fish-qwen-refine-worker/wait-for-comfyui.sh
ExecStart=/opt/fish-qwen-refine-worker/.venv/bin/uvicorn worker:app --host 0.0.0.0 --port 8002 --workers 1
Restart=always
RestartSec=5
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
